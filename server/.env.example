# ClearMyMind Server — copy to .env and fill in. Never commit .env.

PORT=3001
NODE_ENV=development
# Set to 1 when running behind a reverse proxy (Render, Fly, nginx…)
TRUST_PROXY=

# Firebase project whose ID tokens are accepted (no service account needed)
FIREBASE_PROJECT_ID=nistha-passi-core

# Client URL used to build verification email links
CLIENT_URL=http://localhost:5173/clearmyMind

# Brevo SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
